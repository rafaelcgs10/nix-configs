+static void _dcp_process(float *const restrict out,
+                         const float *const restrict in,
+                         const size_t npixels,
+                         const dt_iop_colorin_data_t *const d,
+                         const dt_aligned_pixel_t corr)
+{
+  const dt_dcp_prepared_t *const pr = &d->dcp_prep;
+  const gboolean tables = pr->has_tables && d->dcp_tables;
+  const dt_dcp_table_t *const hsm = pr->hsm.data ? &pr->hsm : NULL;
+  const dt_dcp_table_t *const look = pr->look.data ? &pr->look : NULL;
+  const float vscale = d->dcp_value_scale;
+  const gboolean vclip = d->dcp_clip;
+
+  dt_colormatrix_t M;
+  memcpy(M, tables ? pr->cam_to_prophoto : pr->cam_to_xyz, sizeof(M));
+  dt_colormatrix_t P;
+  memcpy(P, pr->prophoto_to_xyz, sizeof(P));
+
+  DT_OMP_FOR()
+  for(size_t k = 0; k < npixels; k++)
+  {
+    const float r = in[4 * k] * corr[0], g = in[4 * k + 1] * corr[1],
+                b = in[4 * k + 2] * corr[2];
+    dt_aligned_pixel_t xyz;
+    float x0 = M[0][0] * r + M[0][1] * g + M[0][2] * b;
+    float x1 = M[1][0] * r + M[1][1] * g + M[1][2] * b;
+    float x2 = M[2][0] * r + M[2][1] * g + M[2][2] * b;
+
+    if(tables)
+    {
+      float h, s, v;
+      if(dt_dcp_rgb_to_hsv(x0, x1, x2, &h, &s, &v))
+      {
+        if(hsm) dt_dcp_apply_table(hsm, &h, &s, &v, vscale, vclip);
+        if(look) dt_dcp_apply_table(look, &h, &s, &v, vscale, vclip);
+        dt_dcp_hsv_to_rgb(h, s, v, &x0, &x1, &x2);
+      }
+      const float p0 = x0, p1 = x1, p2 = x2;
+      x0 = P[0][0] * p0 + P[0][1] * p1 + P[0][2] * p2;
+      x1 = P[1][0] * p0 + P[1][1] * p1 + P[1][2] * p2;
+      x2 = P[2][0] * p0 + P[2][1] * p1 + P[2][2] * p2;
+    }
+
+    xyz[0] = x0; xyz[1] = x1; xyz[2] = x2; xyz[3] = 0.0f;
+    dt_aligned_pixel_t lab;
+    dt_XYZ_to_Lab(xyz, lab);
+    lab[3] = in[4 * k + 3];
+    copy_pixel_nontemporal(out + 4 * k, lab);
+  }
+  dt_omploop_sfence();
+}
