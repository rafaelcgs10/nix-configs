+/* ---------------------------------------------------------------------
+   Adobe DNG camera profile (.dcp) path.
+
+   The profile's ForwardMatrix expects camera RGB divided by the camera
+   neutral -- exactly the state darktable's white balance produces with
+   the as-shot coefficients, so no residual correction is applied here
+   (see commit_params).
+
+   Adobe's HueSatMap/LookTable are defined on D50-adapted data in linear
+   ProPhoto, so the tables run there; afterwards the illuminant cast is
+   restored (dt_dcp_prepare bakes that into prophoto_to_xyz) to leave the
+   data in the same state darktable's own camera matrices produce -- the
+   white balance and color calibration modules therefore keep working
+   unchanged. The profile tone curve is deliberately not applied:
+   darktable's tone mapper owns that decision.
+*/
+/* When color calibration is enabled it adapts the illuminant itself (the
+   documented scene-referred workflow), so the DCP must hand it the cast in
+   exactly the form it will remove: the inverse of the CAT16 full adaptation
+   from the camera illuminant that channelmixerrgb's "as shot in camera"
+   mode detects. This mirrors _get_white_balance_coeff() and the
+   DT_ILLUMINANT_CAMERA runtime path of channelmixerrgb.c -- the pair then
+   cancels exactly and the net rendering equals the profile-adapts design,
+   while color calibration stays on and owns creative white balance. */
+static gboolean _dcp_cc_adaptation(dt_iop_module_t *self,
+                                   dt_dev_pixelpipe_t *pipe,
+                                   double xy[2],
+                                   double unadapt_m[9])
+{
+  if(!pipe->cc_adaptation.adapting) return FALSE;
+  const dt_adaptation_t kind = (dt_adaptation_t)pipe->cc_adaptation.kind;
+
+  const dt_dev_chroma_t *chr = &self->dev->chroma;
+  dt_aligned_pixel_t custom_wb = { 1.0f, 1.0f, 1.0f, 1.0f };
+  if(dt_image_is_matrix_correction_supported(&pipe->image))
+  {
+    const gboolean is_d65 = chr->late_correction
+      ? dt_dev_equal_chroma(chr->wb_coeffs, chr->as_shot)
+      : dt_dev_equal_chroma(chr->wb_coeffs, chr->D65coeffs);
+    const gboolean valid_chroma = chr->D65coeffs[0] > 0.0
+      && chr->D65coeffs[1] > 0.0 && chr->D65coeffs[2] > 0.0;
+    const gboolean changed_chroma = chr->wb_coeffs[0] > 1.0f
+      || chr->wb_coeffs[1] > 1.0f || chr->wb_coeffs[2] > 1.0f;
+    if(!is_d65 && valid_chroma && changed_chroma)
+      for_four_channels(k)
+        custom_wb[k] = (float)(chr->D65coeffs[k] / chr->wb_coeffs[k]);
+  }
+
+  float x = 0.f, y = 0.f;
+  if(!find_temperature_from_raw_coeffs(&pipe->image, custom_wb, &x, &y))
+    return FALSE;
+  xy[0] = x;
+  xy[1] = y;
+
+  // build the adaptation matrix by probing the XYZ basis vectors through
+  // the very functions color calibration applies per pixel (full Bradford
+  // is nonlinear per pixel; the linear Bradford probe approximates it)
+  dt_aligned_pixel_t illum_XYZ, illum_LMS;
