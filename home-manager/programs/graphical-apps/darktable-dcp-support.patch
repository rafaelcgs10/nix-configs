+/** Adobe DNG camera profile (.dcp) support.
+ *
+ * A DCP is a TIFF/IFD container holding the DNG color-profile tags. We use
+ * the parts that describe COLOR only:
+ *
+ *   ColorMatrix1/2      XYZ -> camera; used to estimate the scene illuminant
+ *   ForwardMatrix1/2    white-balanced camera RGB -> XYZ(D50); the renderer
+ *   HueSatMap1/2        (hue, sat, value) -> (hue shift, sat scale, val scale)
+ *   LookTable           same shape, the profile's subjective "look"
+ *
+ * The profile tone curve is deliberately NOT used: darktable's own tone
+ * mapper (agx/sigmoid/filmic) owns that decision.
+ */
+
+#define DT_DCP_MAX_NAME 256
+
+typedef struct dt_dcp_table_t
+{
+  int dims[3];        // hue, sat, value divisions
+  gboolean srgb;      // value axis is sRGB-encoded (index only)
+  float *data;        // dims[2]*dims[0]*dims[1] triples (value-major)
+} dt_dcp_table_t;
+
+typedef struct dt_dcp_t
+{
+  char name[DT_DCP_MAX_NAME];
+  char camera_model[DT_DCP_MAX_NAME];
+
+  int illuminant[2];              // DNG CalibrationIlluminant codes
+  double temperature[2];          // their correlated color temperatures
+
+  gboolean has_color_matrix[2];
+  gboolean has_forward_matrix[2];
+  double color_matrix[2][9];      // XYZ -> camera
+  double forward_matrix[2][9];    // WB'd camera -> XYZ(D50)
+
+  dt_dcp_table_t hsm[2];          // HueSatMap, per illuminant
+  dt_dcp_table_t look;            // LookTable (single)
+
+  float baseline_exposure_offset; // EV, informational (not applied)
+  gboolean valid;
+} dt_dcp_t;
+
+/** Per-image prepared state: illuminant-interpolated matrices and tables. */
+typedef struct dt_dcp_prepared_t
+{
+  dt_colormatrix_t cam_to_xyz;    // WB'd camera RGB -> XYZ, un-adapted
+                                  // (carries the scene cast, like darktable's
+                                  //  own camera matrix, so color calibration
+                                  //  keeps working normally)
+  // Adobe's tables operate on D50-adapted data in ProPhoto, so the transform
+  // is also available split: camera -> ProPhoto(D50) [tables] -> XYZ un-adapted
+  dt_colormatrix_t cam_to_prophoto;
+  dt_colormatrix_t prophoto_to_xyz;
+  gboolean has_tables;
+  dt_dcp_table_t hsm;             // interpolated copy (data owned)
+  dt_dcp_table_t look;            // shallow copy of the profile's look table
+  double scene_xy[2];             // estimated scene illuminant chromaticity
+  double temperature;             // its CCT
+  // The camera's response to the scene white, computed from the DNG
+  // ColorMatrix (dng_color_spec::SetWhiteXY). The ForwardMatrix is defined
+  // for camera RGB divided by exactly this, which also fixes the absolute
+  // level the value-axis of the tables is sampled at.
+  double camera_white[3];
+} dt_dcp_prepared_t;
+
+/** Load and parse a .dcp file. Returns NULL on failure. */
+dt_dcp_t *dt_dcp_load(const char *filename);
+/** header_only skips the hue/sat tables -- fast path for enumeration. */
+dt_dcp_t *dt_dcp_load_ex(const char *filename, const gboolean header_only);
+void dt_dcp_free(dt_dcp_t *dcp);
+
+/** Prepare the per-image transform.
+ *
+ * neutral = the camera's raw response to the scene white (i.e. the as-shot
+ * neutral, 1/white-balance-multipliers, green-normalized). Estimates the
+ * scene illuminant, interpolates matrices/tables for it, and builds a
+ * camera->XYZ matrix that leaves the scene cast in place.
+ */
+gboolean dt_dcp_prepare(const dt_dcp_t *dcp,
+                        const double neutral[3],
+                        gboolean unadapt,
+                        dt_dcp_prepared_t *out);
+/** Like dt_dcp_prepare, but when unadapt_matrix is non-NULL it is used as
+ * the un-adaptation transform (row-major 3x3, applied to XYZ D50) instead
+ * of the Bradford D50->scene matrix. Used to hand the illuminant cast to
+ * color calibration in exactly the form that module will remove. */
+gboolean dt_dcp_prepare_full(const dt_dcp_t *dcp,
+                             const double neutral[3],
+                             gboolean unadapt,
+                             const double *unadapt_matrix,
+                             dt_dcp_prepared_t *out);
+/** Invert a row-major 3x3 double matrix. Returns FALSE if singular. */
+gboolean dt_dcp_m3_invert(const double in[9], double out[9]);
+void dt_dcp_prepared_cleanup(dt_dcp_prepared_t *p);
+
+/** Apply a DNG hue/sat/value table to one pixel, Adobe-style.
+ *
+ * h in [0,6), s and v >= 0 (v unbounded: the value axis is only a lookup
+ * index, so it is clamped for the lookup and never clamps the pixel).
+ */
+void dt_dcp_apply_table(const dt_dcp_table_t *t, float *h, float *s, float *v,
+                        const float value_scale, const gboolean clip);
+
+/** Adobe-style RGB<->HSV (hue in [0,6)). Returns FALSE for pixels with a
+ *  negative channel: those are out of gamut, the tables are meaningless
+ *  there and the caller should apply the matrix only (as ART does). */
+static inline gboolean dt_dcp_rgb_to_hsv(const float r, const float g,
+                                         const float b,
+                                         float *h, float *s, float *v)
+{
+  if(r < 0.0f || g < 0.0f || b < 0.0f) return FALSE;
+  const float mx = MAX(r, MAX(g, b));
+  const float mn = MIN(r, MIN(g, b));
+  *v = mx;
+  const float gap = mx - mn;
+  if(mx <= 0.0f) { *h = 0.0f; *s = 0.0f; return TRUE; }
+  *s = gap / mx;
+  if(gap <= 0.0f) { *h = 0.0f; return TRUE; }
+  float hh;
+  if(r >= mx)      hh = (g - b) / gap;
+  else if(g >= mx) hh = 2.0f + (b - r) / gap;
+  else             hh = 4.0f + (r - g) / gap;
+  if(hh < 0.0f) hh += 6.0f;
+  *h = hh;
+  return TRUE;
+}
+
+static inline void dt_dcp_hsv_to_rgb(float h, const float s, const float v,
+                                     float *r, float *g, float *b)
+{
+  if(s <= 0.0f) { *r = *g = *b = v; return; }
+  while(h < 0.0f) h += 6.0f;
+  while(h >= 6.0f) h -= 6.0f;
+  const int i = (int)h;
+  const float f = h - (float)i;
+  const float p = v * (1.0f - s);
+  const float q = v * (1.0f - s * f);
+  const float t = v * (1.0f - s * (1.0f - f));
+  switch(i)
+  {
+    case 0:  *r = v; *g = t; *b = p; break;
+    case 1:  *r = q; *g = v; *b = p; break;
+    case 2:  *r = p; *g = v; *b = t; break;
+    case 3:  *r = p; *g = q; *b = v; break;
+    case 4:  *r = t; *g = p; *b = v; break;
+    default: *r = v; *g = p; *b = q; break;
+  }
+}
