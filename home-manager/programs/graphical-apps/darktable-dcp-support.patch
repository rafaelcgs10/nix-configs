+  if(!img->camera_makermodel[0] && !img->camera_model[0]) return TRUE;
+  const char *base = prof->filename[0] ? g_strrstr(prof->filename, "/") : NULL;
+  base = base ? base + 1 : prof->filename;
+  if(img->camera_makermodel[0]
+     && (_strcasestr(prof->name, img->camera_makermodel)
