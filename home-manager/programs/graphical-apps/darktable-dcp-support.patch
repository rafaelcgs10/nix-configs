+static gboolean _strcasestr(const char *haystack, const char *needle)
+{
+  if(!haystack || !needle || !needle[0]) return FALSE;
+  gchar *h = g_ascii_strdown(haystack, -1);
+  gchar *n = g_ascii_strdown(needle, -1);
+  const gboolean found = strstr(h, n) != NULL;
+  g_free(h);
+  g_free(n);
+  return found;
