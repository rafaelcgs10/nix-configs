+/** Scan {userconfig,datadir}/color/dcp for Adobe DNG camera profiles and
+ *  offer them in the input profile list. They carry no ICC profile: the
+ *  input color profile module handles DT_COLORSPACE_DCP natively (see
+ *  common/dcp.c), a placeholder profile is attached only so that generic
+ *  list handling has something valid to hold on to. */
+static GList *load_dcp_from_dir(void)
+{
+  GList *temp_profiles = NULL;
+  char confdir[PATH_MAX] = { 0 };
+  char datadir[PATH_MAX] = { 0 };
+  dt_loc_get_user_config_dir(confdir, sizeof(confdir));
+  dt_loc_get_datadir(datadir, sizeof(datadir));
+
+  for(int which = 0; which < 2; which++)
+  {
+    char *dirname = g_build_filename(which ? datadir : confdir, "color", "dcp", NULL);
+    GDir *dir = g_dir_open(dirname, 0, NULL);
+    if(dir)
+    {
+      const gchar *d_name;
+      while((d_name = g_dir_read_name(dir)))
+      {
+        if(g_ascii_strcasecmp(d_name + MAX(0, (int)strlen(d_name) - 4), ".dcp"))
+          continue;
+        char *filename = g_build_filename(dirname, d_name, NULL);
+        dt_dcp_t *dcp = dt_dcp_load_ex(filename, TRUE);
+        if(dcp)
+        {
+          dt_colorspaces_color_profile_t *prof =
+            calloc(1, sizeof(dt_colorspaces_color_profile_t));
+          if(prof)
+          {
+            // prefix the camera model so profiles for several cameras can
+            // be told apart in the input profile list (unless the profile
+            // name already carries it, e.g. ART's bundled "CANON EOS RP")
+            gchar *lname = dcp->name[0] ? g_ascii_strdown(dcp->name, -1) : NULL;
+            gchar *lcam = dcp->camera_model[0]
+              ? g_ascii_strdown(dcp->camera_model, -1) : NULL;
+            const gboolean has_cam = lname && lcam && strstr(lname, lcam);
+            g_free(lname);
+            g_free(lcam);
+            if(dcp->name[0] && dcp->camera_model[0] && !has_cam)
+              g_snprintf(prof->name, sizeof(prof->name), "%s: %s",
+                         dcp->camera_model, dcp->name);
+            else if(dcp->name[0])
+              g_snprintf(prof->name, sizeof(prof->name), "%s", dcp->name);
+            else
+              g_snprintf(prof->name, sizeof(prof->name), "%s", d_name);
+            g_strlcpy(prof->filename, filename, sizeof(prof->filename));
+            prof->type = DT_COLORSPACE_DCP;
+            prof->profile = cmsCreate_sRGBProfile();  // placeholder, unused
+            prof->in_pos = -1;
+            prof->out_pos = -1;
+            prof->display_pos = -1;
+            prof->display2_pos = -1;
+            prof->category_pos = -1;
+            prof->work_pos = -1;
+            temp_profiles = g_list_prepend(temp_profiles, prof);
+          }
+          dt_dcp_free(dcp);
+        }
+        g_free(filename);
+      }
+      g_dir_close(dir);
+    }
+    g_free(dirname);
+    if(temp_profiles) break;   // user config wins over the shipped folder
+  }
+  return g_list_sort(temp_profiles, _sort_profiles);
+}
