#@gui <b>Filmator</b>
#@gui Film Rebate:fx_film_rebate,fx_film_rebate_preview(0)
#@gui :_=note("<b>Scanned-negative rebate border.</b> Rounded corners, soft cut, inward falloff. Randomized: every run gives a unique frame.")
#@gui :Inset (%)=float(1.8,0.5,5)
#@gui :Side Variation (%)=float(0.35,0,1)
#@gui :Corner Radius (%)=float(0.8,0,3)
#@gui :Cut Softness (px/1000px)=float(1.2,0,10)
#@gui :Waviness (px/1000px)=float(2,0,10)
#@gui :Falloff Width (px/1000px)=float(18,0,60)
#@gui :Falloff Strength=float(0.4,0,1)
#@gui :Output as Separate Layer=bool(1)
#@gui :_=note("<small>With separate layer ON, run this with the <b>topmost</b> layer active so the border lands above everything (e.g. above a light-leak layer).</small>")

# Builds the combined rebate mask as a float image in [0,1].
# $1-$7 = filter params, $8 = width, $9 = height.
_film_rebate_mask :
  W=$8 H=$9 M={max($8,$9)}
  IL={round($M*($1+u(-$2,$2))/100)}
  IR={round($M*($1+u(-$2,$2))/100)}
  IT={round($M*($1+u(-$2,$2))/100)}
  IB={round($M*($1+u(-$2,$2))/100)}
  R={round($M*$3/100)}
  $W,$H,1,1
  rectangle. {$IL+$R},{$IT+$R},{$W-1-$IR-$R},{$H-1-$IB-$R},1,255
  dilate_circ. {2*$R+1}
  $W,$H,1,2 noise. 50 blur. {0.04*$W} normalize. {-$5*$W/1000},{$5*$W/1000}
  warp.. .,1,1,1 rm.
  +blur. {$6*$W/1000}
  blur.. {$4*$W/1000}
  f.. "(i/255)*((1-$7)+$7*i#-1/255)" rm.

# In-place: multiplies the border into each selected image (CLI / batch use).
film_rebate :
  foreach {
    to_rgb
    _film_rebate_mask $1,$2,$3,$4,$5,$6,$7,{w},{h}
    mul
  }

fx_film_rebate : skip ${8=1}
  if $8
    # Border as its own layer: black RGBA whose alpha is the inverted mask
    # (opaque rebate, semi-transparent falloff, clear center). The plugin
    # inserts extra output images as new layers above the active one.
    _film_rebate_mask $1,$2,$3,$4,$5,$6,$7,{0,w},{0,h}
    f. "(1-i)*255"
    100%,100%,1,3,0
    rv[-2,-1] a[-2,-1] c
    name. "name(film rebate)"
  else
    film_rebate $1,$2,$3,$4,$5,$6,$7
  fi

fx_film_rebate_preview :
  film_rebate $1,$2,$3,$4,$5,$6,$7
