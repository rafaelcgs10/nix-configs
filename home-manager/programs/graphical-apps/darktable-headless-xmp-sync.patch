+  // has not got (see dt_control_crawler_sync_folder()); "--dry-run" then only
+  // prints the plan.
+  gboolean sync_xmp_and_exit = FALSE;
+  gboolean sync_dry_run = FALSE;
+  const char *sync_folder = NULL;
+  for(int k = 1; k < argc; k++)
+  {
+    int take = 0;
+    if(argv[k] && !strcmp(argv[k], "--sync-xmp"))
+    {
+      sync_xmp_and_exit = TRUE;
+      take = 1;
+    }
+    else if(argv[k] && !strcmp(argv[k], "--dry-run"))
+    {
+      sync_dry_run = TRUE;
+      take = 1;
+    }
+    else if(argv[k] && !strcmp(argv[k], "--sync-folder") && k + 1 < argc)
+    {
+      sync_folder = argv[k + 1];
+      sync_xmp_and_exit = TRUE;
+      take = 2;
+    }
+    if(take)
