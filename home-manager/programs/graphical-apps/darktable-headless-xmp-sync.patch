+// add version `version' of image `base_id' to the library, its edit read
+// from `xmpfilename': the same steps _image_read_duplicates() takes for a
+// sidecar beyond the first, for a sidecar made on another computer. the
+// sidecar is read before anything writes one, so it is not overwritten.
+dt_imgid_t dt_image_add_version_from_xmp(const dt_imgid_t base_id,
+                                         const int version,
+                                         const char *xmpfilename)
+{
+  const dt_imgid_t newid = _image_duplicate_with_version_ext(base_id, version);
+  if(!dt_is_valid_imgid(newid)) return NO_IMGID;
+
+  const dt_image_t *base = dt_image_cache_get(base_id, 'r');
+  const dt_imgid_t grpid = base ? base->group_id : NO_IMGID;
+  dt_image_cache_read_release(base);
+
+  dt_image_t *img = dt_image_cache_get(newid, 'w');
+  if(img)
+  {
+    dt_exif_xmp_read(img, xmpfilename, FALSE);
+    img->version = version;
+  }
+  dt_image_cache_write_release(img, DT_IMAGE_CACHE_RELAXED);
+
+  if(dt_is_valid_imgid(grpid)) dt_grouping_add_to_group(grpid, newid);
+  return newid;
+}
