+// headless XMP -> database synchronisation, for a scheduled/service run.
+// intended to be called after a non-GUI dt_init(), so the startup crawler can
+// be disabled and this cost paid off the interactive path. reloads the XMP of
+// every image whose sidecar is newer than the database entry (the "keep the
+// XMP edit" action). returns the number of images successfully synchronised.
+int dt_control_crawler_sync_xmp_to_db(void)
+{
+  GList *changed = dt_control_crawler_run();
+
+  int synced = 0;
+  int failed = 0;
+  for(GList *iter = changed; iter; iter = g_list_next(iter))
+  {
+    dt_control_crawler_result_t *entry = iter->data;
+
+    // dt_control_crawler_run() only ever reports sidecars that are newer than
+    // the database, so the correct direction is always XMP -> DB. guard anyway.
+    if(entry->timestamp_xmp > entry->timestamp_db)
+    {
+      _db_update_timestamp(entry->id, entry->timestamp_xmp);
+      const gboolean error = dt_history_load_and_apply(entry->id, entry->xmp_path, 0);
+      if(error)
+      {
+        failed++;
+        dt_print(DT_DEBUG_ALWAYS,
+                 "[crawler] FAILED to sync XMP -> DB for `%s'", entry->image_path);
+      }
+      else
+      {
+        synced++;
+        dt_print(DT_DEBUG_CONTROL,
+                 "[crawler] synced XMP -> DB for `%s'", entry->image_path);
+      }
+    }
+
+    _free_crawler_result(entry);
+  }
+  g_list_free_full(changed, g_free);
+
+  dt_print(DT_DEBUG_ALWAYS,
+           "[crawler] headless XMP -> DB sync done: %d updated, %d failed", synced, failed);
+  return synced;
+}
