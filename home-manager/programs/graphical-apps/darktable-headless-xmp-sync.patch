+  // Headless XMP -> database sync for a scheduled service. We detect and strip
+  // our private "--sync-xmp" option here because dt_init() aborts on unknown
+  // options. When present we run a non-GUI init and reconcile updated sidecars
+  // instead of starting the darkroom.
+  gboolean sync_xmp_and_exit = FALSE;
+  for(int k = 1; k < argc; k++)
+  {
+    if(argv[k] && !strcmp(argv[k], "--sync-xmp"))
+    {
+      sync_xmp_and_exit = TRUE;
+      // compact argv so dt_init() never sees the unknown option
+      for(int j = k; j < argc - 1; j++) argv[j] = argv[j + 1];
+      argv[--argc] = NULL;
+      k--;
+    }
+  }
+
+  if(sync_xmp_and_exit)
+  {
+    // init_gui = FALSE: no GTK, no dialogs. If another darktable holds the
+    // library lock, dt_init() returns non-zero without any UI and we abort this
+    // run — the scheduler will retry later. Exit code 75 (EX_TEMPFAIL) marks
+    // this expected "could not run now" case so the service manager can tell it
+    // apart from a real crash.
+    if(dt_init(argc, argv, FALSE, TRUE, NULL))
+      exit(75);
+
+    dt_control_crawler_sync_xmp_to_db();
+    dt_cleanup();
+    exit(0);
+  }
