+// headless XMP -> database synchronisation, for a scheduled/service run.
+// intended to be called after a non-GUI dt_init(), so the startup crawler can
+// be disabled and this cost paid off the interactive path. reloads the XMP of
+// every image whose sidecar is newer than the database entry (the "keep the
+// XMP edit" action). returns the number of images successfully synchronised.
+int dt_control_crawler_sync_xmp_to_db(void)
+{
+  GList *changed = dt_control_crawler_run();
+
+  int synced = 0;
+  int failed = 0;
+  for(GList *iter = changed; iter; iter = g_list_next(iter))
+  {
+    dt_control_crawler_result_t *entry = iter->data;
+
+    // dt_control_crawler_run() only ever reports sidecars that are newer than
+    // the database, so the correct direction is always XMP -> DB. guard anyway.
+    if(entry->timestamp_xmp > entry->timestamp_db)
+    {
+      _db_update_timestamp(entry->id, entry->timestamp_xmp);
+      const gboolean error = dt_history_load_and_apply(entry->id, entry->xmp_path, 0);
+      if(error)
+      {
+        failed++;
+        dt_print(DT_DEBUG_ALWAYS,
+                 "[crawler] FAILED to sync XMP -> DB for `%s'", entry->image_path);
+      }
+      else
+      {
+        synced++;
+        dt_print(DT_DEBUG_CONTROL,
+                 "[crawler] synced XMP -> DB for `%s'", entry->image_path);
+      }
+    }
+
+    _free_crawler_result(entry);
+  }
+  g_list_free_full(changed, g_free);
+
+  dt_print(DT_DEBUG_ALWAYS,
+           "[crawler] headless XMP -> DB sync done: %d updated, %d failed", synced, failed);
+  return synced;
+}
+
+// headless sync of one folder's sidecars into the library, for edits made on
+// another computer. for each image file in `dirname' (not its subfolders):
+//  - not in the library: import it; darktable's import reads its sidecars,
+//    every version included ("new image");
+//  - in the library, with a version sidecar (IMG_x_01.CR3.xmp...) whose
+//    version the library has not got: add that version from it ("new
+//    version");
+//  - in the library, with a sidecar newer than the library's write timestamp
+//    (by more than MAX_TIME_SKEW): load its history, as the crawler's "keep
+//    the XMP edit" does ("newer edit"). a library edit that is newer is kept.
+// with dry_run nothing is changed, the plan is only printed. returns the
+// number of changes (made, or planned with dry_run), or -1 when the folder
+// cannot be read.
+
+typedef struct _folder_xmp_t
+{
+  int version;
+  gchar *name;        // the sidecar's file name
+} _folder_xmp_t;
+
+static void _folder_xmp_free(gpointer data)
+{
+  _folder_xmp_t *sc = data;
+  g_free(sc->name);
+  g_free(sc);
+}
+
+// for g_ptr_array_sort(), which hands over pointers to the elements
+static gint _folder_xmp_cmp(gconstpointer a, gconstpointer b)
+{
+  return (*(_folder_xmp_t *const *)a)->version - (*(_folder_xmp_t *const *)b)->version;
+}
+
+static gint _folder_name_cmp(gconstpointer a, gconstpointer b)
+{
+  return g_strcmp0(*(const gchar *const *)a, *(const gchar *const *)b);
+}
+
+static gboolean _folder_has_suffix_ci(const char *name, const char *suffix)
+{
+  const size_t n = strlen(name), k = strlen(suffix);
+  return n > k && !g_ascii_strcasecmp(name + n - k, suffix);
+}
+
+// would darktable's import take this file? the same tests
+// _image_import_internal() makes on the extension.
+static gboolean _folder_importable(const char *name)
+{
+  if(name[0] == '.' || _folder_has_suffix_ci(name, ".xmp")) return FALSE;
+  const char *dot = strrchr(name, '.');
+  if(!dot || !dot[1]) return FALSE;
+  gchar *ext = g_ascii_strdown(dot + 1, -1);
+  gboolean ok = FALSE;
+  for(const char **i = dt_supported_extensions; *i != NULL; i++)
+    if(!strcmp(ext, *i)) { ok = TRUE; break; }
+  if(ok && !dt_imageio_is_raw_by_extension(ext) && strcmp(ext, "dng")
+     && dt_conf_get_bool("ui_last/import_ignore_nonraws"))
+    ok = FALSE;
+  g_free(ext);
+  return ok;
+}
+
+// which image file and version a sidecar belongs to: IMG.CR3.xmp is
+// version 0 of IMG.CR3, IMG_01.CR3.xmp version 1 (as darktable names them).
+static gboolean _folder_parse_xmp(const char *xmp, GHashTable *files,
+                                  gchar **image, int *version)
+{
+  const size_t len = strlen(xmp);
+  gchar *base = g_strndup(xmp, len - 4);         // without ".xmp"
+  if(g_hash_table_contains(files, base))
+  {
+    *image = base;
+    *version = 0;
+    return TRUE;
+  }
+  gboolean found = FALSE;
+  const char *dot = strrchr(base, '.');
+  const char *us = dot ? g_strrstr_len(base, dot - base, "_") : NULL;
+  if(us && us + 1 < dot)
+  {
+    gboolean digits = TRUE;
+    for(const char *c = us + 1; c < dot; c++)
+      if(!g_ascii_isdigit(*c)) { digits = FALSE; break; }
+    if(digits)
+    {
+      gchar *stem = g_strndup(base, us - base);
+      gchar *img = g_strconcat(stem, dot, NULL);
+      g_free(stem);
+      if(g_hash_table_contains(files, img))
+      {
+        gchar *num = g_strndup(us + 1, dot - us - 1);
+        *version = atoi(num);
+        g_free(num);
+        *image = img;
+        found = TRUE;
+      }
+      else
+        g_free(img);
+    }
+  }
+  g_free(base);
+  return found;
+}
+
+static gboolean _folder_mtime(const char *dir, const char *name, time_t *mtime)
+{
+  gchar *path = g_build_filename(dir, name, NULL);
+  GStatBuf st;
+  const gboolean ok = !g_stat(path, &st);
+  if(ok) *mtime = st.st_mtime;
+  g_free(path);
+  return ok;
+}
+
+static void _folder_time(const time_t t, char *buf, const size_t size)
+{
+  struct tm tm;
+  strftime(buf, size, "%Y-%m-%d %H:%M:%S", localtime_r(&t, &tm));
+}
+
+int dt_control_crawler_sync_folder(const char *dirname, const gboolean dry_run)
+{
+  // film rolls are stored as absolute paths without a closing '/'
+  gchar *dir;
+  if(g_path_is_absolute(dirname))
+    dir = g_strdup(dirname);
+  else
+  {
+    gchar *cwd = g_get_current_dir();
+    dir = g_build_filename(cwd, dirname, NULL);
+    g_free(cwd);
+  }
+  for(size_t dl = strlen(dir); dl > 1 && dir[dl - 1] == '/'; dl--) dir[dl - 1] = '\0';
+
+  GError *error = NULL;
+  GDir *gdir = g_dir_open(dir, 0, &error);
+  if(!gdir)
+  {
+    fprintf(stderr, "can't read folder %s: %s\n", dir, error ? error->message : "?");
+    g_clear_error(&error);
+    g_free(dir);
+    return -1;
+  }
+
+  // one listing of the folder answers every question below
+  GHashTable *files = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);
+  GPtrArray *images = g_ptr_array_new();       // borrowed from `files'
+  GPtrArray *xmps = g_ptr_array_new_with_free_func(g_free);
+  const gchar *entry;
+  while((entry = g_dir_read_name(gdir)) != NULL)
+  {
+    gchar *path = g_build_filename(dir, entry, NULL);
+    const gboolean is_dir = g_file_test(path, G_FILE_TEST_IS_DIR);
+    g_free(path);
+    if(is_dir) continue;
+    gchar *name = g_strdup(entry);
+    g_hash_table_add(files, name);
+    if(_folder_has_suffix_ci(name, ".xmp"))
+      g_ptr_array_add(xmps, g_strdup(name));
+    else if(_folder_importable(name))
+      g_ptr_array_add(images, name);
+  }
+  g_dir_close(gdir);
+  g_ptr_array_sort(images, _folder_name_cmp);
+
+  // image file -> its sidecars, by version
+  GHashTable *sidecars = g_hash_table_new_full(g_str_hash, g_str_equal, g_free,
+                                               (GDestroyNotify)g_ptr_array_unref);
+  for(guint i = 0; i < xmps->len; i++)
+  {
+    gchar *image = NULL;
+    int version = 0;
+    const char *xmp = g_ptr_array_index(xmps, i);
+    if(!_folder_parse_xmp(xmp, files, &image, &version)) continue;
+    GPtrArray *list = g_hash_table_lookup(sidecars, image);
+    if(!list)
+    {
+      list = g_ptr_array_new_with_free_func(_folder_xmp_free);
+      g_hash_table_insert(sidecars, g_strdup(image), list);
+    }
+    _folder_xmp_t *entry_xmp = g_new0(_folder_xmp_t, 1);
+    entry_xmp->version = version;
+    entry_xmp->name = g_strdup(xmp);
+    g_ptr_array_add(list, entry_xmp);
+    g_free(image);
+  }
+
+  dt_filmid_t filmid = dt_film_get_id(dir);
+  if(dt_is_valid_filmid(filmid))
+    printf("folder %s (film roll %d): %u images, %u sidecars\n",
+           dir, filmid, images->len, xmps->len);
+  else
+    printf("folder %s (not in the library yet): %u images, %u sidecars\n",
+           dir, images->len, xmps->len);
+
+  sqlite3_stmt *find = NULL;
+  DT_DEBUG_SQLITE3_PREPARE_V2(dt_database_get(darktable.db),
+                              "SELECT id, write_timestamp FROM main.images"
+                              " WHERE film_id = ?1 AND filename = ?2 AND version = ?3",
+                              -1, &find, NULL);
+
+  int n_new = 0, n_new_bare = 0, n_version = 0, n_newer = 0, n_same = 0, n_failed = 0;
+  const char *verb_new = dry_run ? "new image  " : "imported   ";
+  const char *verb_version = dry_run ? "new version" : "added      ";
+  const char *verb_newer = dry_run ? "newer edit " : "loaded     ";
+
+  for(guint i = 0; i < images->len; i++)
+  {
+    const char *name = g_ptr_array_index(images, i);
+    GPtrArray *list = g_hash_table_lookup(sidecars, name);
+    if(list) g_ptr_array_sort(list, _folder_xmp_cmp);
+    const dt_imgid_t base_id = dt_is_valid_filmid(filmid)
+      ? dt_image_get_id(filmid, name) : NO_IMGID;
+
+    if(!dt_is_valid_imgid(base_id))
+    {
+      // not in the library: darktable's own import, sidecars and all
+      if(!list) n_new_bare++;
+      else n_new++;
+      if(dry_run)
+      {
+        if(list)
+        {
+          printf("  %s %s (%u edit%s)\n", verb_new, name, list->len,
+                 list->len == 1 ? "" : "s");
+        }
+        continue;
+      }
+      if(!dt_is_valid_filmid(filmid))
+      {
+        dt_film_t film;
+        dt_film_init(&film);
+        filmid = dt_film_new(&film, dir);
+        dt_film_cleanup(&film);
+        if(!dt_is_valid_filmid(filmid))
+        {
+          fprintf(stderr, "can't add the folder %s to the library\n", dir);
+          n_failed++;
+          break;
+        }
+      }
+      gchar *path = g_build_filename(dir, name, NULL);
+      const dt_imgid_t id = dt_image_import(filmid, path, FALSE, FALSE);
+      g_free(path);
+      if(dt_is_valid_imgid(id))
+      {
+        if(list) printf("  %s %s (%u edit%s)\n", verb_new, name, list->len,
+                        list->len == 1 ? "" : "s");
+      }
+      else
+      {
+        printf("  FAILED to import %s\n", name);
+        n_failed++;
+      }
+      continue;
+    }
+
+    if(!list) { n_same++; continue; }
+
+    for(guint j = 0; j < list->len; j++)
+    {
+      const _folder_xmp_t *sc = g_ptr_array_index(list, j);
+      time_t mtime = 0;
+      if(!_folder_mtime(dir, sc->name, &mtime)) continue;
+
+      sqlite3_reset(find);
+      sqlite3_clear_bindings(find);
+      DT_DEBUG_SQLITE3_BIND_INT(find, 1, filmid);
+      DT_DEBUG_SQLITE3_BIND_TEXT(find, 2, name, -1, SQLITE_STATIC);
+      DT_DEBUG_SQLITE3_BIND_INT(find, 3, sc->version);
+      dt_imgid_t id = NO_IMGID;
+      time_t written = 0;
+      if(sqlite3_step(find) == SQLITE_ROW)
+      {
+        id = sqlite3_column_int(find, 0);
+        written = sqlite3_column_int64(find, 1);
+      }
+
+      gchar *xmp_path = g_build_filename(dir, sc->name, NULL);
+      if(!dt_is_valid_imgid(id))
+      {
+        n_version++;
+        if(!dry_run)
+        {
+          const dt_imgid_t newid = dt_image_add_version_from_xmp(base_id, sc->version, xmp_path);
+          if(dt_is_valid_imgid(newid))
+            _db_update_timestamp(newid, mtime);
+          else
+          {
+            printf("  FAILED to add %s\n", sc->name);
+            n_failed++;
+            g_free(xmp_path);
+            continue;
+          }
+        }
+        printf("  %s %s\n", verb_version, sc->name);
+      }
+      else if(written + MAX_TIME_SKEW < mtime)
+      {
+        n_newer++;
+        char t_xmp[32], t_db[32];
+        _folder_time(mtime, t_xmp, sizeof(t_xmp));
+        _folder_time(written, t_db, sizeof(t_db));
+        if(!dry_run)
+        {
+          _db_update_timestamp(id, mtime);
+          if(dt_history_load_and_apply(id, xmp_path, 0))
+          {
+            printf("  FAILED to load %s\n", sc->name);
+            n_failed++;
+            g_free(xmp_path);
+            continue;
+          }
+        }
+        printf("  %s %s (sidecar %s, library %s)\n", verb_newer, sc->name, t_xmp, t_db);
+      }
+      else
+        n_same++;
+      g_free(xmp_path);
+    }
+  }
+  sqlite3_finalize(find);
+
+  const int changes = n_new + n_new_bare + n_version + n_newer;
+  if(n_new_bare)
+    printf("  %s %d image%s with no sidecar\n", dry_run ? "new image  " : "imported   ",
+           n_new_bare, n_new_bare == 1 ? "" : "s");
+  if(changes == 0 && n_failed == 0)
+    printf("nothing to change: the library has every edit in this folder\n");
+  else
+    printf("%s: %d new image%s (%d with edits), %d new version%s, %d newer edit%s,"
+           " %d unchanged, %d failed\n",
+           dry_run ? "plan" : "done",
+           n_new + n_new_bare, n_new + n_new_bare == 1 ? "" : "s", n_new,
+           n_version, n_version == 1 ? "" : "s",
+           n_newer, n_newer == 1 ? "" : "s", n_same, n_failed);
+
+  g_hash_table_destroy(sidecars);
+  g_ptr_array_free(images, TRUE);
+  g_ptr_array_unref(xmps);
+  g_hash_table_destroy(files);
+  g_free(dir);
+  return n_failed ? -1 : changes;
+}
