" vim:foldmethod=marker foldlevel=0

" Colorscheme is set by catppuccin/nix (catppuccin.nvim) -> `colorscheme catppuccin`.

" ## Settings {{{
nnoremap <silent> <C-L> :nohlsearch<CR><C-L>

" map*leader {{{
let mapleader=" "
let maplocalleader="\\"
" }}}

" TTY Performance {{{
set nocompatible
set synmaxcol=300
set ttyfast
set lazyredraw
set clipboard=unnamedplus
" }}}
"
set number

